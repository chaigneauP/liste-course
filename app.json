{
  "expo": {
    "name": "liste-course",
    "slug": "liste-course",
    "version": "1.0.0",
    "scheme": "liste-course",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pchaigneau.listecourse"
    },
    "android": {
      "package": "com.pchaigneau.listecourse",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1E8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "android": {
            "resizeMode": "native"
          },
          "dark": {
            "backgroundColor": "#1E1C18",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "./plugins/withAndroidSplashFullImage.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0bb0f1a9-0d50-445b-903a-cab930a66b15"
      }
    },
    "owner": "chaigneaup"
  }
}

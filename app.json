{
  "expo": {
    "name": "liste-course",
    "slug": "liste-course",
    "version": "1.0.0",
    "scheme": "liste-course",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pchaigneau.listecourse"
    },
    "android": {
      "package": "com.pchaigneau.listecourse",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0bb0f1a9-0d50-445b-903a-cab930a66b15"
      }
    },
    "owner": "chaigneaup"
  }
}
